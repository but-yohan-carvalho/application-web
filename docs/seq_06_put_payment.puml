@startuml seq_06_put_payment

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam sequenceArrowThickness 2

title PUT /order/<id> : paiement (mise en file RQ -> 202)

actor       Client
participant "routes.py"    as Routes
participant "OrderService" as OS
database    "PostgreSQL"   as DB
queue       "RQ / Redis"   as RQ

Client -> Routes : PUT /order/42\n{ "credit_card": { "number": "4242...", "cvv": "123", ... } }
Routes -> OS     : get(42)
OS -> DB         : SELECT * FROM "order" WHERE id = 42
DB --> OS        : Order
OS --> Routes    : Order

alt commande introuvable
    Routes --> Client : 404 Not Found

else commande deja payee (paid = true)
    Routes --> Client : 422 { "errors": { "order": { "code": "already-paid" } } }

else paiement deja en cours (status = processing)
    Routes --> Client : 409 Conflict { "errors": { "order": { "code": "conflict" } } }

else email ou adresse manquants
    Routes --> Client : 422 { "errors": { "order": { "code": "missing-fields" } } }

else informations completes
    Routes -> DB     : UPDATE "order" SET status = 'processing'
    DB --> Routes    : ok
    Routes -> RQ     : enqueue process_payment(42, credit_card)
    RQ --> Routes    : job en file
    Routes --> Client : 202 Accepted (sans corps)
    note over RQ : traitement asynchrone\npar le worker -> voir seq_07
end

@enduml
